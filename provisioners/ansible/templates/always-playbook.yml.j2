#jinja2:lstrip_blocks: True
---
-
  name: "Always run Ansible Provisioning Playbook"
  become: true
  gather_facts: true
  hosts: all
  {% if role_vars is defined and role_vars and role_vars != "" %}
  vars:
    core_provisioner_version: {{ core_provisioner_version }}
    provisioner_name: {{ provisioner_name }}
    provisioner_version: {{ provisioner_version }}
    {% for key, value in role_vars.items() %}
    {{ key }}: {{ value | to_json }}
    {% endfor %}
  {% endif %}
  {% if collections is defined and collections and collections != "" %}
  collections:
    {% for key, value in collections.items() %}
    {{ key }}: {{ value }}
    {% endfor %}
  {% endif %}
  roles:
    {# Only always-tagged roles are rendered: the once-roles used to be listed
       with when-guards, which skipped them but still walked every task and
       emitted a second full progress sequence — breaking anything tracking
       the play's PROGRESS output. #}
    {% for role in provision_roles %}
    {% set tag_list = role.tags | default([]) %}
    {% if 'always' in tag_list %}
    -
      role: {{ role.name }}
      {% if role.when is defined %}
      when: {{ role.when }}
      {% endif %}
      {% if tag_list is iterable and tag_list is not string %}
      tags:
      {% for tag in tag_list %}
        - {{ tag }}
      {% endfor %}
      {% else %}
      tags:
        - {{ tag_list }}
      {% endif %}
      {% if role.vars is defined %}
      {# Role-entry vars render as role PARAMS (scoped to this role instance only). #}
      {# The vars keyword on a roles entry is play-scoped in Ansible: one role's #}
      {# run_tasks: false would silently disable every other role in the play. #}
      {% for key, value in role.vars.items() %}
      {{ key }}: {{ value | to_json }}
      {% endfor %}
      {% endif %}
      {% if role.port_forwards is defined %}
      {# port_forwards stay play-scoped on purpose: other roles consume them. #}
      vars:
        {{ role.name }}_port_forwards:
          {% for ports in role.port_forwards %}
            -
              guest: {{ ports.guest }}
              host: {{ ports.host }}
              ip: {{ ports.ip }}
              {% if ports.url is defined %}
              url: {{ ports.url }}
              {% endif %}
              {% if ports.proxied is defined %}
              proxied: {{ ports.proxied }}
              {% endif %}
          {% endfor %}
      {% endif %}
    {% endif %}
    {% endfor %}
